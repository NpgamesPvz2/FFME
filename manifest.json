{
  "manifest_version": 3,
  "name": "Facebook Feed Marker Extension",
  "version": "0.7.4.5",
  "description": "Đánh dấu bài đăng trước mốc thời gian T và từ mốc thời gian T trở đi; có nút nổi mở cài đặt ngay trên Facebook",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "content/scanner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup/popup.html",
        "popup/popup.css",
        "popup/popup.js"
      ],
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Facebook Feed Marker Extension",
    "default_popup": "popup/popup.html"
  },
  "key": ""
}
